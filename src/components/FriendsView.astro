---
import Base from '../layouts/Base.astro';
import { friends } from '../lib/data';
import { t } from '../i18n/ui';
import type { Lang } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const altHref = lang === 'zh' ? '/friends/' : '/zh/friends/';
---
<Base title={t(lang, 'friends')} lang={lang} alt={altHref}>
  <section class="post-head">
    <h1>{t(lang, 'friends')}</h1>
    <p class="post-lede">{t(lang, 'friendsLede')}</p>
  </section>

  <section class="sec-body" style="max-width: 680px; margin-top: 32px;">
    <ul class="rows">
      {friends.map((friend) => (
        <li>
          <div>
            <a href={friend.url} target="_blank" rel="noopener">{friend.name}</a>
            <p class="tagline">{lang === 'zh' ? friend.descZh ?? friend.desc : friend.desc}</p>
          </div>
          <span class="avatar">{friend.avatar ?? friend.name.slice(0, 2)}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>
