---
// Local time and current conditions, opt-in from site.config.yaml.
// Weather comes from Open-Meteo, which needs no key; point `endpoint` at your
// own proxy if you would rather keep a private provider behind a server.
import { weather as w } from '../lib/config';
const enabled = w.enabled === true && typeof w.latitude === 'number' && typeof w.longitude === 'number';
const zh = Astro.currentLocale === 'zh' || Astro.url.pathname.startsWith('/zh');
const label = zh ? (w.labelZh ?? w.label ?? '') : (w.label ?? '');
const units = w.units === 'fahrenheit' ? 'fahrenheit' : 'celsius';
const unitMark = units === 'fahrenheit' ? '°F' : '°C';
---

{enabled && (
  <span
    class="wc"
    data-lat={w.latitude}
    data-lon={w.longitude}
    data-tz={w.timezone ?? 'UTC'}
    data-units={units}
    data-endpoint={w.endpoint ?? ''}
    data-label-zh={zh ? '晴' : 'Clear'}
  >
    {label && <span class="wc-place">{label}</span>}
    <span class="wc-time" data-wc-time aria-live="off">--:--</span>
    <span class="wc-temp" data-wc-temp aria-live="off"></span>
    <span class="wc-sep" aria-hidden="true">·</span>
    <span class="wc-cond" data-wc-cond></span>
  </span>
)}

<script>
  const root = document.querySelector<HTMLElement>('.wc');
  if (root) {
    const tz = root.dataset.tz || 'UTC';
    const timeEl = root.querySelector<HTMLElement>('[data-wc-time]')!;
    const tempEl = root.querySelector<HTMLElement>('[data-wc-temp]')!;
    const condEl = root.querySelector<HTMLElement>('[data-wc-cond]')!;
    const sep = root.querySelector<HTMLElement>('.wc-sep')!;
    const zh = document.documentElement.lang.startsWith('zh');
    const units = root.dataset.units || 'celsius';
    const mark = units === 'fahrenheit' ? '°F' : '°C';

    const tick = () => {
      timeEl.textContent = new Intl.DateTimeFormat(zh ? 'zh-CN' : 'en-GB', {
        timeZone: tz,
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      }).format(new Date());
    };
    tick();
    setInterval(tick, 30_000);

    const codes: Record<number, [string, string]> = {
      0: ['Clear', '晴'],
      1: ['Mostly clear', '晴间多云'],
      2: ['Partly cloudy', '多云'],
      3: ['Overcast', '阴'],
      45: ['Fog', '雾'],
      48: ['Fog', '雾'],
      51: ['Drizzle', '小雨'],
      53: ['Drizzle', '小雨'],
      55: ['Drizzle', '小雨'],
      61: ['Rain', '雨'],
      63: ['Rain', '雨'],
      65: ['Heavy rain', '大雨'],
      71: ['Snow', '雪'],
      73: ['Snow', '雪'],
      75: ['Heavy snow', '大雪'],
      80: ['Showers', '阵雨'],
      81: ['Showers', '阵雨'],
      82: ['Heavy showers', '强阵雨'],
      95: ['Thunderstorm', '雷雨'],
      96: ['Thunderstorm', '雷雨'],
      99: ['Thunderstorm', '雷雨'],
    };

    const key = `inkfolio:weather:${root.dataset.lat},${root.dataset.lon},${units}`;
    const paint = (temp: number, code: number) => {
      tempEl.textContent = `${Math.round(temp)}${mark}`;
      const [en, cn] = codes[code] ?? ['—', '—'];
      condEl.textContent = zh ? cn : en;
      sep.hidden = false;
    };

    try {
      const cached = sessionStorage.getItem(key);
      if (cached) {
        const { temp, code, at } = JSON.parse(cached);
        if (Date.now() - at < 15 * 60_000) paint(temp, code);
      }
    } catch {}

    const endpoint = root.dataset.endpoint;
    const url = endpoint
      ? endpoint
      : `https://api.open-meteo.com/v1/forecast?latitude=${root.dataset.lat}&longitude=${root.dataset.lon}` +
        `&current=temperature_2m,weather_code&temperature_unit=${units}&timezone=auto`;

    fetch(url, { headers: { Accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then((data) => {
        const temp = endpoint ? data.temperature : data.current?.temperature_2m;
        const code = endpoint ? data.code : data.current?.weather_code;
        if (typeof temp !== 'number') return;
        paint(temp, Number(code));
        try {
          sessionStorage.setItem(key, JSON.stringify({ temp, code, at: Date.now() }));
        } catch {}
      })
      .catch(() => {
        // No weather today: leave the clock and drop the separator.
        sep.hidden = true;
      });
  }
</script>

<style>
  .wc {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .wc-place {
    font-weight: 550;
  }
  .wc-time,
  .wc-temp {
    color: var(--muted);
  }
  .wc-sep {
    color: var(--line, currentColor);
    opacity: 0.7;
  }
  .wc-cond {
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .wc {
      gap: 6px;
    }
  }
</style>
