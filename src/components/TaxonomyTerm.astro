---
import Base from '../layouts/Base.astro';
import { langPath, site, type Lang } from '../lib/config';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  kind: 'categories' | 'tags';
  term: string;
  posts: { id: string; title: string; description: string; date: Date }[];
  alt?: string;
}

const { lang, kind, term, posts, alt } = Astro.props;
const label = t(lang, kind);
const fmt = (d: Date) =>
  new Date(d).toLocaleDateString(lang === 'en' ? 'en-GB' : 'zh-CN', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
---
<Base title={`${term} — ${site.name}`} description={`${label}: ${term}, ${posts.length} ${lang === 'en' ? 'posts' : '篇'}.`} lang={lang} alt={alt}>
  <section class="art-head">
    <span class="kicker"><a href={langPath(`/${kind}/`, lang)}>{label}</a></span>
    <h1>{term}</h1>
    <p class="meta">
      <span class="pf-count">{posts.length}</span>
      <a href={langPath(`/${kind}/`, lang)}>{label}</a>
    </p>
  </section>
  <ul class="tag-list">
    {posts.map((post) => (
      <li>
        <a href={langPath(`/posts/${post.id}/`, lang)}>
          <b>{post.title}</b>
          {post.description && <small>{post.description.slice(0, 110)}</small>}
          <span class="meta2">{fmt(post.date)}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
