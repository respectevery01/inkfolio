---
import Base from '../layouts/Base.astro';
import { site, social, type Lang } from '../lib/config';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const altHref = lang === 'zh' ? '/contact/' : '/zh/contact/';
---
<Base title={t(lang, 'contact')} lang={lang} alt={altHref}>
  <section class="post-head">
    <h1>{t(lang, 'contact')}</h1>
    <p class="post-lede">{t(lang, 'contactLede')}</p>
  </section>

  <section class="sec-body" style="max-width: 620px; margin-top: 32px;">
    <ul class="contact-list">
      {site.email && (
        <li><span class="contact-k">Email</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
      )}
      {social.map((item) => (
        <li><span class="contact-k">{item.label}</span><a href={item.href} target="_blank" rel="noopener">{item.href.replace(/^https?:\/\//, '')}</a></li>
      ))}
    </ul>
  </section>
</Base>
