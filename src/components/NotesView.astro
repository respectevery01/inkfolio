---
import Base from '../layouts/Base.astro';
import notesData from '../data/notes.yaml?raw';
import { parse } from 'yaml';
import { t } from '../i18n/ui';
import type { Lang } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === 'zh';
const altHref = zh ? '/notes/' : '/zh/notes/';
const notes = (parse(notesData) as { date: string; text: string; textZh?: string }[]).sort(
  (a, b) => b.date.localeCompare(a.date)
);
const fmt = (d: string) => new Date(`${d}T00:00:00Z`).toLocaleDateString(zh ? 'zh-CN' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={t(lang, 'notes')} lang={lang} alt={altHref}>
  <section class="post-head">
    <h1>{t(lang, 'notes')}</h1>
    <p class="post-lede">{t(lang, 'notesLede')}</p>
  </section>

  <section class="sec-body" style="max-width: 640px; margin-top: 32px;">
    <ul class="moments">
      {notes.map((note) => (
        <li>
          <time datetime={note.date}>{fmt(note.date)}</time>
          <p>{zh ? note.textZh ?? note.text : note.text}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
