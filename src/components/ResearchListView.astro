---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { langPath, type Lang } from '../lib/config';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const collection = lang === 'zh' ? 'researchZh' : 'research';
const entries = (await getCollection(collection as 'research' | 'researchZh'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const fmt = (d: Date) => new Date(d).toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const altHref = lang === 'zh' ? '/research/' : '/zh/research/';
---
<Base title={t(lang, 'research')} lang={lang} alt={altHref}>
  <section class="post-head">
    <h1>{t(lang, 'research')}</h1>
    <p class="post-lede">{t(lang, 'researchLede')}</p>
  </section>

  <section class="sec-body" style="max-width: 680px; margin-top: 32px;">
    <ul class="rows">
      {entries.map((entry) => (
        <li>
          <div>
            <a href={langPath(`/research/${entry.id}/`, lang)}>{entry.data.title}</a>
            {entry.data.description && <p class="tagline">{entry.data.description}</p>}
          </div>
          <time class="meta" datetime={new Date(entry.data.date).toISOString()}>{entry.data.type} · {fmt(new Date(entry.data.date))}</time>
        </li>
      ))}
    </ul>
  </section>
</Base>
