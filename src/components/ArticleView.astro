---
import Base from '../layouts/Base.astro';
import { site, type Lang } from '../lib/config';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  badge?: string;
  backHref: string;
  backLabel: string;
  alt?: string;
}
const { lang, title, description = '', date, updated, tags = [], badge, backHref, backLabel, alt } = Astro.props;

const fmt = (d: Date) => new Date(d).toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={title} description={description} lang={lang} alt={alt} article={{ published: date, updated, tags }}>
  <article>
    <header class="post-head">
      <div class="crumbs">
        <a href={backHref}>{backLabel}</a>
      </div>
      {badge && <p class="badge">{badge}</p>}
      <h1>{title}</h1>
      {description && <p class="post-lede">{description}</p>}
      <div class="byline">
        <div class="who"><span class="who-name">{lang === 'zh' ? site.authorZh : site.author}</span></div>
        <div class="when">
          <time datetime={new Date(date).toISOString()}>{fmt(new Date(date))}</time>
          {updated && <div>{t(lang, 'updated')} {fmt(new Date(updated))}</div>}
        </div>
      </div>
      {tags.length > 0 && <div class="tags">{tags.map((tag) => <span class="tag">{tag}</span>)}</div>}
    </header>

    <div class="post-body">
      <div class="post-main prose">
        <slot />
      </div>
    </div>

    <div class="post-end">
      <a class="backlink" href={backHref}>← {backLabel}</a>
    </div>
  </article>
</Base>
