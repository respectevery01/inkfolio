---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { langPath, type Lang } from '../lib/config';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const entry = await getEntry('pages', lang === 'zh' ? 'about-zh' : 'about');
if (!entry) throw new Error(`Missing about page content for "${lang}" (src/content/pages/about${lang === 'zh' ? '-zh' : ''}.md)`);
const { Content } = await render(entry);
const altHref = lang === 'zh' ? '/about/' : '/zh/about/';
---
<Base title={entry.data.title} description={entry.data.description} lang={lang} alt={altHref}>
  <article>
    <header class="post-head">
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p class="post-lede">{entry.data.description}</p>}
    </header>
    <div class="post-body">
      <div class="post-main prose">
        <Content />
      </div>
    </div>
    <div class="post-end">
      <a class="backlink" href={langPath('/', lang)}>← {t(lang, 'home')}</a>
    </div>
  </article>
</Base>
