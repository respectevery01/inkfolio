---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
import type { Lang } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === 'zh';
const altHref = zh ? '/posts/' : '/zh/posts/';

const collection = zh ? 'postsZh' : 'posts';
const entries = (await getCollection(collection as 'posts' | 'postsZh'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const fmt = (d: Date) => new Date(d).toLocaleDateString(zh ? 'zh-CN' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const data = entries.map((e) => ({
  title: e.data.title,
  desc: (e.data.description || '').slice(0, 110),
  cat: e.data.tags?.[0] ?? (zh ? '随笔' : 'Essays'),
  date: fmt(new Date(e.data.date)),
  ts: new Date(e.data.date).getTime(),
  img: '',
  href: zh ? `/zh/posts/${e.id}/` : `/posts/${e.id}/`,
}));

const cats = [zh ? '全部' : 'All', ...new Set(data.map((d) => d.cat))];
const PER = 10;

const labels = {
  count: (n: number) => (zh ? `${n} 篇文章` : `${n} posts`),
  lede: zh
    ? '关于建站、SEO、Cloudflare 和 AI agent 的长文与笔记。'
    : 'Build notes and essays on SEO, Cloudflare, self-hosting and AI agents.',
  search: zh ? '搜索文章' : 'Search posts',
  placeholder: zh ? '标题、摘要…' : 'Titles, summaries…',
  latest: zh ? '最新' : 'Latest',
  read: zh ? '读这篇' : 'Read the post',
  empty: zh ? '没有匹配的文章。' : 'No matching posts.',
};
---
<Base title={t(lang, 'posts')} lang={lang} alt={altHref}>
  <section class="art-head">
    <h1>{zh ? '文章' : 'Posts'}</h1>
    <p class="meta"><span class="pf-count">{labels.count(data.length)}</span>{labels.lede}</p>
  </section>

  <div class="pf-controls">
    <div class="pf-topics" id="pfTopics">
      {cats.map((c, i) => <button class="pf-topic" data-cat={c} aria-pressed={i === 0}>{c}</button>)}
    </div>
    <div class="pf-search">
      <label for="pfSearch">{labels.search}</label>
      <input id="pfSearch" type="search" placeholder={labels.placeholder} autocomplete="off" />
    </div>
  </div>

  <section class="pf-latest" id="pfLatest" hidden>
    <h2 class="pf-label">{labels.latest}</h2>
    <article class="pf-feat" id="pfFeat"></article>
  </section>

  <ul class="pf-list" id="pfList"></ul>
  <nav class="pf-pager" id="pfPager" aria-label="Pagination"></nav>
  <p class="pf-empty" id="pfEmpty" hidden>{labels.empty}</p>

  <script is:inline define:vars={{ data, cats, PER, readLabel: labels.read }}>
    (function () {
      var all = cats[0];
      var st = { cat: all, q: '', page: 1 };
      var list = document.getElementById('pfList');
      var featBox = document.getElementById('pfFeat');
      var latest = document.getElementById('pfLatest');
      var pager = document.getElementById('pfPager');
      var empty = document.getElementById('pfEmpty');

      function esc(s) { var d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }
      function filtered() {
        var q = st.q.trim().toLowerCase();
        return data.filter(function (p) {
          if (st.cat !== all && p.cat !== st.cat) return false;
          if (q && (p.title + ' ' + p.desc).toLowerCase().indexOf(q) < 0) return false;
          return true;
        });
      }
      function rowHTML(p) {
        return '<li class="pf-row"><article class="pf-item noimg">' +
          '<div class="pf-body"><h3 class="pf-rt"><a href="' + p.href + '">' + esc(p.title) + '</a></h3>' +
          (p.desc ? '<p class="pf-desc">' + esc(p.desc) + '</p>' : '') +
          '<p class="pf-meta">' + p.date + ' · ' + esc(p.cat) + '</p></div></article></li>';
      }
      function featHTML(p) {
        return '<div class="pf-feat-body"><h3 class="pf-feat-title"><a href="' + p.href + '">' + esc(p.title) + '</a></h3>' +
          (p.desc ? '<p class="pf-feat-desc">' + esc(p.desc) + '</p>' : '') +
          '<p class="pf-feat-meta">' + p.date + ' · ' + esc(p.cat) + '</p>' +
          '<p class="pf-feat-read"><a href="' + p.href + '">' + esc(readLabel) + '</a></p></div>';
      }
      function renderPager(total) {
        var pages = Math.ceil(total / PER);
        pager.innerHTML = '';
        if (pages <= 1) return;
        for (var i = 1; i <= pages; i++) {
          var b = document.createElement('button');
          b.textContent = i;
          if (i === st.page) b.setAttribute('aria-current', 'page');
          b.addEventListener('click', (function (n) { return function () { st.page = n; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); }; })(i));
          pager.appendChild(b);
        }
      }
      function render() {
        var items = filtered();
        var showFeat = st.cat === all && !st.q && st.page === 1 && items.length > 0;
        if (showFeat) {
          featBox.innerHTML = featHTML(items[0]);
          latest.hidden = false;
          items = items.slice(1);
        } else { latest.hidden = true; }
        var slice = items.slice((st.page - 1) * PER, st.page * PER);
        list.innerHTML = slice.map(rowHTML).join('');
        renderPager(items.length);
        empty.hidden = items.length > 0;
      }
      document.querySelectorAll('.pf-topic').forEach(function (b) {
        b.addEventListener('click', function () {
          st.cat = b.dataset.cat; st.page = 1;
          document.querySelectorAll('.pf-topic').forEach(function (x) { x.setAttribute('aria-pressed', x === b); });
          render();
        });
      });
      var si = document.getElementById('pfSearch'), tm;
      si.addEventListener('input', function () { clearTimeout(tm); tm = setTimeout(function () { st.q = si.value; st.page = 1; render(); }, 160); });
      render();
    })();
  </script>
</Base>
