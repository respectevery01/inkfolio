---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, langPath, type Lang } from '../lib/config';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const collection = lang === 'zh' ? 'postsZh' : 'posts';
const entries = (await getCollection(collection as 'posts' | 'postsZh'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const fmt = (d: Date) => new Date(d).toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-GB', { day: 'numeric', month: lang === 'zh' ? 'long' : 'long', year: 'numeric' });
const tagline = lang === 'zh' ? site.taglineZh : site.tagline;
const altHref = lang === 'zh' ? '/' : '/zh/';
---
<Base title={lang === 'zh' ? site.nameZh : site.name} lang={lang} alt={altHref}>
  <section class="home-hero">
    <div>
      <h1>{tagline}</h1>
      <div class="intro prose">
        <p>{lang === 'zh' ? site.descriptionZh : site.description}</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="sec-head">
      <h2>{t(lang, 'latestPosts')}</h2>
      <a class="more" href={langPath('/posts/', lang)}>{t(lang, 'allPosts')}</a>
    </div>
    <div class="sec-body">
      {entries.length === 0 && <p class="empty">—</p>}
      <ul class="rows">
        {entries.slice(0, 8).map((entry) => (
          <li>
            <div>
              <a href={langPath(`/posts/${entry.id}/`, lang)}>{entry.data.title}</a>
              {entry.data.description && <p class="tagline">{entry.data.description}</p>}
            </div>
            <time class="meta" datetime={new Date(entry.data.date).toISOString()}>{fmt(new Date(entry.data.date))}</time>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
