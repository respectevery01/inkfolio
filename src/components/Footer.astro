---
import { footer, footerColumns, site, social, type Lang } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === 'zh';
const path = Astro.url.pathname || '/';
const base = zh ? '/zh' : '';
const to = (href: string) => (href.startsWith('http') ? href : `${base}${href}` || '/');
const cur = (href: string) => {
  const target = to(href);
  return path === target || (target !== '/' && path.startsWith(target)) ? 'page' : undefined;
};
const note = zh ? footer.noteZh : footer.note;
const year = new Date().getFullYear();
const socials = social.map((item) => ({ ...item, href: to(item.href), external: item.href.startsWith('http') }));
---
<footer class="foot" data-chrome-s="footer">
  <div class="foot-inner">
    <div class="foot-cols">
      {footerColumns.map((col) => (
        <nav>
          <p class="foot-h">{zh ? col.titleZh : col.title}</p>
          <ul>
            {col.links.map((link) => (
              <li>
                <a href={to(link.href)} aria-current={cur(link.href)}>{zh ? link.labelZh ?? link.label : link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="foot-bottom">
      <span class="foot-legal">
        © {year} {footer.copyrightName}
        {footer.authorUrl && (
          <> · <a href={footer.authorUrl} rel="noopener">{footer.authorLabel || footer.authorUrl.replace(/^https?:\/\//, '')}</a></>
        )}
        {' '}· {note}
      </span>
      <span class="foot-soc">
        {socials.map((item) => (
          <a href={item.href} rel={item.external ? 'noopener' : undefined} target={item.external ? '_blank' : undefined}>{item.label}</a>
        ))}
        {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
      </span>
    </div>
  </div>
</footer>
<style is:global>
  .foot-legal a { color: var(--muted); }
  .foot-legal a:hover { color: var(--ink); text-decoration-line: underline; text-decoration-style: wavy; text-decoration-color: var(--u); text-decoration-thickness: 1.5px; text-underline-offset: 4px; }
  .foot-soc { display: inline-flex; flex-wrap: wrap; gap: 16px; }
  .foot-soc a { color: var(--muted); text-decoration: none; }
  .foot-soc a:hover { color: var(--ink); text-decoration-line: underline; text-decoration-style: wavy; text-decoration-color: var(--u); text-decoration-thickness: 1.5px; text-underline-offset: 4px; }
</style>
