---
import { footer, site, social, type Lang } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const note = lang === 'zh' ? footer.noteZh : footer.note;
const links = social.map((item) => ({
  label: item.label,
  href: item.href.startsWith('http') ? item.href : lang === 'zh' ? `/zh${item.href}` : item.href,
  external: item.href.startsWith('http'),
}));
---
<footer class="foot">
  <div class="foot-inner">
    <div class="foot-bottom">
      <p class="foot-note">
        {note}
        {site.email && <> · <a href={`mailto:${site.email}`}>{site.email}</a></>}
      </p>
      <ul class="foot-links">
        {links.map((link) => (
          <li>
            <a href={link.href} rel={link.external ? 'noopener' : undefined} target={link.external ? '_blank' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
