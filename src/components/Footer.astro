---
import { footer, footerLinks, site, social, type Lang } from '../lib/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const note = lang === 'zh' ? footer.noteZh : footer.note;
const withLang = (href: string) => (href.startsWith('http') ? href : lang === 'zh' ? `/zh${href}` : href);

const pages = footerLinks
  .map((item) => ({
    label: lang === 'zh' ? item.labelZh ?? null : item.label,
    href: withLang(item.href),
    external: item.href.startsWith('http'),
  }))
  .filter((item) => item.label !== null) as { label: string; href: string; external: boolean }[];

const links = social.map((item) => ({
  label: item.label,
  href: withLang(item.href),
  external: item.href.startsWith('http'),
}));
---
<footer class="foot">
  <div class="foot-inner">
    <div class="foot-cols">
      <div>
        <h2 class="foot-h">{lang === 'zh' ? site.nameZh : site.name}</h2>
        <p class="foot-note">{lang === 'zh' ? site.descriptionZh : site.description}</p>
      </div>
      <div>
        <h2 class="foot-h">{lang === 'zh' ? '页面' : 'Pages'}</h2>
        <ul>
          {pages.map((item) => (
            <li>
              <a href={item.href} rel={item.external ? 'noopener' : undefined} target={item.external ? '_blank' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="foot-h">{lang === 'zh' ? '别处' : 'Elsewhere'}</h2>
        <ul>
          {links.map((link) => (
            <li>
              <a href={link.href} rel={link.external ? 'noopener' : undefined} target={link.external ? '_blank' : undefined}>{link.label}</a>
            </li>
          ))}
          {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <p class="foot-note">{note}</p>
      <ul class="foot-links">
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
