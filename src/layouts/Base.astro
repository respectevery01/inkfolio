---
import Banner from '../components/Banner.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { site, theme, seo, analytics, consent, titleFor, type Lang } from '../lib/config';
import '../styles/global.css';
import '@fortawesome/fontawesome-free/css/all.min.css';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  /** counterpart page in the other language — only pass this when the page really exists */
  alt?: string;
  /** pass this on article pages so structured data carries the real dates */
  article?: { published: Date; updated?: Date; tags?: string[]; section?: string };
  /** keep a page out of search engines (used when a feature is disabled) */
  noindex?: boolean;
  /** widen the content column, e.g. "1200px" for docs */
  maxWidth?: string;
  /** per-page social image; falls back to seo.ogImage */
  ogImage?: string;
}

const { title, description, lang = 'en', alt, article, noindex = false, maxWidth, ogImage: ogImageProp } = Astro.props;

let pageTitle = titleFor(title, lang);
const isHomeTitle = title === site.name || pageTitle === site.name;
if (isHomeTitle) pageTitle = `${site.name} — ${lang !== 'en' ? site.taglineZh || site.tagline : site.tagline}`;
const pageDescription =
  description ||
  [title, lang !== 'en' ? site.descriptionZh : site.description].filter(Boolean).join(' — ').slice(0, 158) ||
  seo.defaultDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const altPath = alt ? new URL(alt, Astro.site).pathname : null;
const hasAlt = !!altPath && altPath !== Astro.url.pathname;
const altUrl = hasAlt ? new URL(alt as string, Astro.site) : canonical;
const selfHreflang = lang === 'en' ? 'en' : 'zh-CN';
const ogImage = ogImageProp || seo.ogImage ? new URL(ogImageProp ?? seo.ogImage, Astro.site).href : undefined;
const locale = lang !== 'en' ? seo.localeZh : seo.locale;

const accentVars = `--accent:${theme.accent};--u:${theme.accent};--radius:${theme.radius};${maxWidth ? `--max-w:${maxWidth};` : ''}`;
const person = {
  '@type': 'Person',
  name: lang !== 'en' ? site.authorZh : site.author,
  url: site.url,
};
const jsonLd = seo.structuredData
  ? article
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description: pageDescription,
        datePublished: new Date(article.published).toISOString(),
        ...(article.updated ? { dateModified: new Date(article.updated).toISOString() } : {}),
        ...(article.tags?.length ? { keywords: article.tags.join(', ') } : {}),
        ...(article.section ? { articleSection: article.section } : {}),
        inLanguage: lang !== 'en' ? 'zh-CN' : 'en',
        mainEntityOfPage: canonical.href,
        ...(ogImage ? { image: ogImage } : {}),
        author: person,
        publisher: person,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: lang !== 'en' ? site.nameZh : site.name,
        url: site.url,
        description: pageDescription,
        inLanguage: lang !== 'en' ? 'zh-CN' : 'en',
        author: person,
      }
  : null;

const umamiOn = analytics.umami.enabled && analytics.umami.scriptUrl && analytics.umami.websiteId;
const gaOn = analytics.googleAnalytics.enabled && analytics.googleAnalytics.measurementId;
const clarityOn = analytics.clarity.enabled && analytics.clarity.projectId;
// Umami sets no cookies, so it loads regardless. GA4 and Clarity wait for consent.
const requireConsent = consent.enabled && (gaOn || clarityOn);
---

<!doctype html>
<html lang={lang !== 'en' ? 'zh-CN' : 'en'} data-theme-mode={theme.defaultMode} style={accentVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={noindex ? 'noindex,follow' : seo.robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {hasAlt && <link rel="alternate" hreflang={selfHreflang} href={canonical} />}
    {hasAlt && <link rel="alternate" hreflang={lang === 'en' ? 'zh-CN' : 'en'} href={altUrl} />}
    {hasAlt && <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonical : altUrl} />}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={lang !== 'en' ? site.nameZh : site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {seo.twitterHandle && <meta name="twitter:site" content={`@${seo.twitterHandle}`} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {seo.keywords.length > 0 && <meta name="keywords" content={seo.keywords.join(', ')} />}

    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang !== 'en' ? site.nameZh : site.name}
      href={new URL(lang !== 'en' ? '/zh/rss.xml' : '/rss.xml', Astro.site)}
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      // Theme is resolved before paint so there is no flash of the wrong mode.
      (function () {
        try {
          var stored = localStorage.getItem('inkfolio-theme');
          var mode = stored || document.documentElement.getAttribute('data-theme-mode') || 'auto';
          var dark = mode === 'dark' || (mode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) document.documentElement.setAttribute('data-theme', 'dark');
        } catch {}
      })();
    </script>

    {umamiOn && (
      <script is:inline defer src={analytics.umami.scriptUrl} data-website-id={analytics.umami.websiteId}></script>
    )}

    {gaOn && !requireConsent && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${analytics.googleAnalytics.measurementId}`}
        ></script>
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${analytics.googleAnalytics.measurementId}');`}
        ></script>
      </>
    )}

    {clarityOn && !requireConsent && (
      <script
        is:inline
        set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","${analytics.clarity.projectId}");`}
      ></script>
    )}

    {requireConsent && <script
      is:inline
      define:vars={{
        ga: analytics.googleAnalytics.measurementId,
        clarity: analytics.clarity.projectId,
        consentKey: consent.storageKey,
      }}
    >
      (function () {
        function granted() {
          try {
            return localStorage.getItem(consentKey) === 'accepted';
          } catch {
            return false;
          }
        }
        function loadGA() {
          if (!ga) return;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          window.gtag('js', new Date());
          window.gtag('config', ga);
        }
        function loadClarity() {
          if (!clarity) return;
          (function (c, l, a, r, i, t, y) {
            c[a] =
              c[a] ||
              function () {
                (c[a].q = c[a].q || []).push(arguments);
              };
            t = l.createElement(r);
            t.async = 1;
            t.src = 'https://www.clarity.ms/tag/' + i;
            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
          })(window, document, 'clarity', 'script', clarity);
        }
        function run() {
          loadGA();
          loadClarity();
        }
        if (granted()) run();
        window.addEventListener('inkfolio:consent', function (e) {
          if (e.detail === 'accepted') run();
        });
      })();
    </script>}
  </head>
  <body>
    <Banner lang={lang} />
    <Nav lang={lang} alt={hasAlt ? (altPath as string) : undefined} />
    <main class="page" data-pagefind-body>
      <slot />
    </main>
    <Footer lang={lang} />
    <BackToTop lang={lang} />
    {consent.enabled && <CookieConsent lang={lang} />}
  <script>
  document.querySelectorAll('.prose pre, .docs-prose pre').forEach(function (pre) {
    if (pre.parentElement && pre.parentElement.classList.contains('cb-body')) return;
    var code = pre.querySelector('code');
    var parent = pre.parentNode; if (!parent) return;
    var name = pre.getAttribute('data-filename') || pre.getAttribute('data-language') || (code && code.getAttribute('data-language')) || 'code';
    var wrap = document.createElement('div'); wrap.className = 'cb';
    var head = document.createElement('div'); head.className = 'cb-head';
    var title = document.createElement('span'); title.className = 'cb-title'; title.textContent = name;
    var btn = document.createElement('button'); btn.type = 'button'; btn.className = 'cb-copy'; btn.textContent = 'Copy';
    head.appendChild(title); head.appendChild(btn);
    var body = document.createElement('div'); body.className = 'cb-body';
    parent.insertBefore(wrap, pre);
    body.appendChild(pre); wrap.appendChild(head); wrap.appendChild(body);
    btn.addEventListener('click', function () {
      var text = code ? (code.textContent || '') : (pre.textContent || '');
      navigator.clipboard.writeText(text).then(function () {
        btn.textContent = 'Copied'; btn.classList.add('is-done');
        setTimeout(function () { btn.textContent = 'Copy'; btn.classList.remove('is-done'); }, 1600);
      });
    });
  });
</script>
</body>
</html>
